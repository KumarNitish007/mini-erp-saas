# Copy to .env (git-ignored) and replace the placeholders. Never commit real secrets.

# SQL Server 'sa' password for the local container (8+ chars, upper/lower/digit/symbol).
MSSQL_SA_PASSWORD=ChangeMe_Local_Only_1

# JWT signing key, at least 32 random characters. Generate one with:
#   openssl rand -base64 48
JWT_KEY=replace-with-a-long-random-string-of-at-least-32-chars

# Seed the fictional "Demo Traders" company on first start.
SEED_DEMO_DATA=true
